.DS_Store
# never commit real ids
pins.json

# pre-publish PII gate: local-only inputs, never committed
# project-specific words (employer, product, repo, place names)
tools/pii_context.txt
# third-party person names used for the class 4 check
tools/pii_names.txt

# assets/ carries the README's visual evidence: metadata-stripped stills, one
# GIF, and the hero SVG. The blanket media excludes above exist to keep RENDER
# OUTPUT out of git; these are curated, stripped, reviewed exhibits, which is
# a different thing. gitignore is last-match-wins, so these negations re-admit
# exactly this directory and nothing else.
!assets/
!assets/**
# samples/ holds the two clips the replay probe's bracket re-measures, a frozen
# control and a live take. It has to escape the blanket *.mp4 above the same way
# assets/ does, or `git add -A` skips it in silence and derive.py fails on every
# clone. That is exactly what happened once. CI caught it because the runner had
# no local copy.
!samples/
!samples/**
.pytest_cache/
